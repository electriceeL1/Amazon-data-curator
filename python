import time
import random
import re
import pandas as pd

from bs4 import BeautifulSoup
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.common.exceptions import InvalidSessionIdException, WebDriverException

# -----------------------------
# 1. Set up Selenium driver
# -----------------------------

def new_driver():
    options = Options()
    options.add_argument("--start-maximized")
    # options.add_argument("--headless")  # optional once everything works
    return webdriver.Chrome(options=options)

driver = new_driver()

# -----------------------------
# 2. Shared regex helpers
# -----------------------------

PRICE_RE = re.compile(r"[\d\.,]+")
OZ_RE = re.compile(r"(\d+(\.\d+)?)\s*(oz|ounce|ounces)", re.IGNORECASE)
PCT_RE = re.compile(r"(\d+(\.\d+)?)\s*%")

hand_keywords = ["handmade", "hand-crafted", "handcrafted", "artisan", "artisanal"]
hand_pattern = "|".join(hand_keywords)


def extract_asin(url: str) -> str | None:
    """Extract ASIN from /dp/ASIN or /gp/product/ASIN."""
    if not isinstance(url, str):
        return None
    m = re.search(r"/[dg]p/([^/]+)", url, flags=re.IGNORECASE)
    return m.group(1) if m else None


def parse_price(text: str) -> float | None:
    """Turn '$14.99' or '14.99' into 14.99."""
    if not isinstance(text, str):
        return None
    text = text.replace(",", "")
    m = re.search(r"[\d\.]+", text)
    return float(m.group()) if m else None


def extract_capacity_oz(text: str) -> float | None:
    """Extract capacity in oz from text like '12 oz mug'."""
    if not isinstance(text, str):
        return None
    m = OZ_RE.search(text)
    return float(m.group(1)) if m else None


def parse_int(text: str) -> int | None:
    """Extract integer from a string like '1,234 ratings'."""
    if not isinstance(text, str):
        return None
    m = PRICE_RE.search(text.replace(",", ""))
    return int(m.group()) if m else None


# -----------------------------
# 3. Price via corePriceDisplay / .a-price / .a-offscreen
# -----------------------------

def extract_price_from_page(soup: BeautifulSoup) -> float | None:
    """
    Try multiple Amazon price patterns on a product detail page.
    Returns a float or None if nothing matches.
    """

    # 1) Core price display container (most common on product pages)
    container = soup.select_one("#corePriceDisplay_desktop_feature_div")
    if container:
        # Usually there's an a-offscreen with full price
        offscreen = container.select_one("span.a-price span.a-offscreen") or container.select_one("span.a-offscreen")
        if offscreen:
            val = parse_price(offscreen.get_text(strip=True))
            if val is not None:
                return val

        # Backup: whole + fraction inside container
        whole_el = container.select_one("span.a-price-whole")
        frac_el = container.select_one("span.a-price-fraction")
        if whole_el:
            whole = whole_el.get_text(strip=True).replace(",", "")
            if frac_el:
                frac = frac_el.get_text(strip=True)
                price_str = f"{whole}.{frac}"
            else:
                price_str = whole
            try:
                return float(price_str)
            except ValueError:
                pass

    # 2) Global .a-price tree
    price_container = soup.select_one("span.a-price")
    if price_container:
        offscreen = price_container.select_one("span.a-offscreen")
        if offscreen:
            val = parse_price(offscreen.get_text(strip=True))
            if val is not None:
                return val

        whole_el = price_container.select_one("span.a-price-whole")
        frac_el = price_container.select_one("span.a-price-fraction")
        if whole_el:
            whole = whole_el.get_text(strip=True).replace(",", "")
            if frac_el:
                frac = frac_el.get_text(strip=True)
                price_str = f"{whole}.{frac}"
            else:
                price_str = whole
            try:
                return float(price_str)
            except ValueError:
                pass

    # 3) Last-resort: any span.a-offscreen on the page
    offscreen_any = soup.select_one("span.a-offscreen")
    if offscreen_any:
        val = parse_price(offscreen_any.get_text(strip=True))
        if val is not None:
            return val

    # Nothing matched
    return None

# -----------------------------
# 4. Histogram via ul#histogramTable + aria-label
# -----------------------------

def extract_histogram_from_ul(soup: BeautifulSoup, total_number_of_reviews: int | None) -> dict:
    """
    Extract star-level review percentages and counts from:
      <ul id="histogramTable"> ... </ul>
    using aria-label like "83 percent of reviews have 5 stars".
    Returns pct_*_star (0-1) and reviews_*_star (estimated counts).
    """
    pct_5 = pct_4 = pct_3 = pct_2 = pct_1 = None
    reviews_5 = reviews_4 = reviews_3 = reviews_2 = reviews_1 = None

    ul = soup.select_one("ul#histogramTable")
    if not ul:
        return {
            "pct_5_star": pct_5,
            "pct_4_star": pct_4,
            "pct_3_star": pct_3,
            "pct_2_star": pct_2,
            "pct_1_star": pct_1,
            "reviews_5_star": reviews_5,
            "reviews_4_star": reviews_4,
            "reviews_3_star": reviews_3,
            "reviews_2_star": reviews_2,
            "reviews_1_star": reviews_1,
        }

    lis = ul.find_all("li", recursive=False)
    for li in lis:
        # Anchor or span carries aria-label
        a_or_span = li.find("a", attrs={"aria-label": True}) or li.find("span", attrs={"aria-label": True})
        if not a_or_span:
            continue

        label = a_or_span["aria-label"].lower()
        # e.g. "83 percent of reviews have 5 stars"
        m = re.search(r"(\d+)\s*percent.*?(\d)\s*star", label)
        if not m:
            continue

        pct_val = float(m.group(1)) / 100.0
        star_num = int(m.group(2))

        if star_num == 5:
            pct_5 = pct_val
        elif star_num == 4:
            pct_4 = pct_val
        elif star_num == 3:
            pct_3 = pct_val
        elif star_num == 2:
            pct_2 = pct_val
        elif star_num == 1:
            pct_1 = pct_val

    # Convert percents to counts using total_number_of_reviews
    if total_number_of_reviews is not None:
        if pct_5 is not None:
            reviews_5 = round(total_number_of_reviews * pct_5)
        if pct_4 is not None:
            reviews_4 = round(total_number_of_reviews * pct_4)
        if pct_3 is not None:
            reviews_3 = round(total_number_of_reviews * pct_3)
        if pct_2 is not None:
            reviews_2 = round(total_number_of_reviews * pct_2)
        if pct_1 is not None:
            reviews_1 = round(total_number_of_reviews * pct_1)

    return {
        "pct_5_star": pct_5,
        "pct_4_star": pct_4,
        "pct_3_star": pct_3,
        "pct_2_star": pct_2,
        "pct_1_star": pct_1,
        "reviews_5_star": reviews_5,
        "reviews_4_star": reviews_4,
        "reviews_3_star": reviews_3,
        "reviews_2_star": reviews_2,
        "reviews_1_star": reviews_1,
    }

# -----------------------------
# 5. Main page scraper (no badge fields)
# -----------------------------

def scrape_main_page(url: str, manual_hint: int | None = None) -> dict:
    asin = extract_asin(url)

    time.sleep(random.uniform(2, 4))
    driver.get(url)
    time.sleep(random.uniform(3, 6))

    html = driver.page_source
    soup = BeautifulSoup(html, "html.parser")

    # Title
    title_el = soup.select_one("#productTitle")
    title = title_el.get_text(strip=True) if title_el else None

    # Bullets + description
    bullets_el = soup.select_one("#feature-bullets")
    bullets_text = bullets_el.get_text(" ", strip=True) if bullets_el else ""

    desc_el = soup.select_one("#productDescription")
    desc_text = desc_el.get_text(" ", strip=True) if desc_el else ""

    description_text = " ".join(t for t in [bullets_text, desc_text] if t)

    # Price via extract_price_from_page
    price_num = extract_price_from_page(soup)

    # List price / discount
    list_price_el = soup.select_one(".basisPrice .a-offscreen") or soup.select_one(".a-text-strike")
    list_price_text = list_price_el.get_text(strip=True) if list_price_el else None
    list_price_num = parse_price(list_price_text) if list_price_text else None

    discount_yes_or_no = None
    amount_of_discount = None
    if price_num is not None and list_price_num is not None and list_price_num > price_num:
        discount_yes_or_no = 1
        amount_of_discount = list_price_num - price_num
    elif price_num is not None:
        discount_yes_or_no = 0

    # Capacity / material / color / special_feature
    capacity_oz = extract_capacity_oz(title or "")

    material = None
    combined_title = (title or "").lower()
    for mat in ["ceramic", "stoneware", "porcelain", "glass", "stainless steel"]:
        if mat in combined_title:
            material = mat
            break

    color_el = soup.select_one("#variation_color_name .selection")
    color = color_el.get_text(strip=True) if color_el else None

    special_feature = bullets_text

    # Overall rating & total reviews
    rating_el = soup.select_one("span[data-hook='rating-out-of-text']")
    average_rating_review = None
    if rating_el:
        m = re.search(r"(\d+(\.\d+)?)\s+out of 5", rating_el.get_text())
        if m:
            average_rating_review = float(m.group(1))

    total_reviews_el = soup.select_one("#acrCustomerReviewText")
    total_number_of_reviews = None
    if total_reviews_el:
        total_number_of_reviews = parse_int(total_reviews_el.get_text(strip=True))

    # Handmade flags (no badge fields)
    is_handmade_title = int(bool(re.search(hand_pattern, title or "", flags=re.IGNORECASE)))
    is_handmade_desc = int(bool(re.search(hand_pattern, description_text or "", flags=re.IGNORECASE)))
    manual_flag = int(bool(manual_hint))

    is_handmade_combined = int(bool(manual_flag or is_handmade_title or is_handmade_desc))

    return {
        "asin": asin,
        "url": url,
        "title": title,
        "price": price_num,
        "discount_yes_or_no": discount_yes_or_no,
        "amount_of_discount": amount_of_discount,
        "capacity_oz": capacity_oz,
        "material": material,
        "color": color,
        "special_feature": special_feature,
        "average_rating_review": average_rating_review,
        "total_number_of_reviews": total_number_of_reviews,
        "is_handmade_hint": manual_flag,
        "is_handmade_title": is_handmade_title,
        "is_handmade_desc": is_handmade_desc,
        "is_handmade_combined": is_handmade_combined,
    }

# -----------------------------
# 6. Combined scraper: main page + histogram
# -----------------------------

def scrape_product_with_histogram(url: str, manual_hint: int | None = None) -> dict:
    """
    Scrape main page and then extract histogram from ul#histogramTable
    on the same rendered page.
    """
    main = scrape_main_page(url, manual_hint=manual_hint)

    html = driver.page_source
    soup = BeautifulSoup(html, "html.parser")
    hist = extract_histogram_from_ul(soup, main["total_number_of_reviews"])

    main.update(hist)
    return main

# -----------------------------
# 7. Debug helper for a single URL
# -----------------------------

def debug_price_for_one_url(url: str):
    global driver
    try:
        driver.get(url)
    except WebDriverException:
        # recreate driver if the session died
        driver = new_driver()
        driver.get(url)

    time.sleep(5)
    soup = BeautifulSoup(driver.page_source, "html.parser")

    print("Title:", soup.select_one("#productTitle").get_text(strip=True)
          if soup.select_one("#productTitle") else None)

    print("\n#corePriceDisplay_desktop_feature_div text:")
    c = soup.select_one("#corePriceDisplay_desktop_feature_div")
    print(c.get_text(" ", strip=True)[:500] if c else "NONE")

    print("\nFirst span.a-price:")
    ap = soup.select_one("span.a-price")
    print(ap.get_text(" ", strip=True)[:500] if ap else "NONE")

    print("\nFirst span.a-offscreen:")
    ao = soup.select_one("span.a-offscreen")
    print(ao.get_text(strip=True) if ao else "NONE")

    print("\nGlobal price extractor result:", extract_price_from_page(soup))

# -----------------------------
# 8. Bulk scrape from CSV
# -----------------------------

# IMPORTANT: mug_links_1.csv must have at least "url" and "is_handmade_hint" columns
links_df = pd.read_csv("mug_links_1.csv")

rows = []
for i, row in links_df.iterrows():
    url = str(row["url"]).strip()  # strip leading/trailing spaces
    manual_hint = row.get("is_handmade_hint", None)
    print(f"{i+1}/{len(links_df)} - {url} (hint={manual_hint})")

    try:
        details = scrape_product_with_histogram(url, manual_hint=manual_hint)
        rows.append(details)
    except InvalidSessionIdException:
        print("Driver session died; recreating driver and retrying.")
        driver.quit()
        driver = new_driver()
        try:
            details = scrape_product_with_histogram(url, manual_hint=manual_hint)
            rows.append(details)
        except Exception as e2:
            print("Still failing on", url, "->", e2)
    except Exception as e:
        print("Error on", url, "->", e)

mugs_df = pd.DataFrame(rows)

print(mugs_df[[
    "title",
    "price",
    "total_number_of_reviews",
    "pct_5_star", "pct_4_star", "pct_3_star", "pct_2_star", "pct_1_star",
    "reviews_5_star", "reviews_4_star", "reviews_3_star", "reviews_2_star", "reviews_1_star"
]].head())

# -----------------------------
# 9. Split and save datasets
# -----------------------------

handmade_df = mugs_df[mugs_df["is_handmade_combined"] == 1].copy()
non_handmade_df = mugs_df[mugs_df["is_handmade_combined"] == 0].copy()

min_n = min(len(handmade_df), len(non_handmade_df))
handmade_sample = handmade_df.sample(min_n, random_state=42)
non_handmade_sample = non_handmade_df.sample(min_n, random_state=42)

handmade_df.to_csv("handmade_mugs_full_selenium_histogram.csv", index=False)
non_handmade_df.to_csv("non_handmade_mugs_full_selenium_histogram.csv", index=False)

handmade_sample.to_csv("handmade_mugs_pilot_selenium_histogram.csv", index=False)
non_handmade_sample.to_csv("non_handmade_mugs_pilot_selenium_histogram.csv", index=False)

# -----------------------------
# 10. Close driver
# -----------------------------

driver.quit()
